# Herboclean — configuração do servidor. Não envie credenciais por chat.
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Rotas e geocodificação opcionais. Exclusivamente no backend.
HEIGIT_API_KEY=
HEIGIT_API_BASE_URL=https://api.heigit.org
HEIGIT_DIRECTIONS_DAILY_LIMIT=100
HEIGIT_GEOCODING_DAILY_LIMIT=100
ROUTE_CACHE_HOURS=24

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
