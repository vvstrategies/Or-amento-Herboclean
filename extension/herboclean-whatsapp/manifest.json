{
  "manifest_version": 3,
  "name": "Herboclean · Atendimento assistido",
  "version": "0.1.2",
  "minimum_chrome_version": "116",
  "description": "Painel da Herboclean ao lado do WhatsApp Web. Preparação assistida; envio sempre manual.",
  "key": "",
  "permissions": [
    "sidePanel"
  ],
  "action": {
    "default_title": "Abrir Herboclean"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "adapter.js",
        "content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost:3310"
  },
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ]
}
